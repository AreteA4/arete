    "@ai-sdk/harness-opencode": "1.0.147",
    "@ai-sdk/sandbox-vercel": "1.0.145",
    "@vercel/sandbox": "3.6.1",
    "ai": "7.0.134",
    "dotenv": "16.6.1",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
