# --- Models: set the gateway key OR provider keys -------------------------
# Vercel AI Gateway: one key serves every harness (Claude Code, Codex,
# OpenCode). Create at https://vercel.com/<team>/~/ai -> API keys. The team
# needs a card on file before the gateway serves requests.
AI_GATEWAY_API_KEY=

# Provider keys, used when AI_GATEWAY_API_KEY is empty. Anthropic covers
# Claude Code; OpenAI covers Codex. OpenCode can use either.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Vercel Sandbox --------------------------------------------------------
# Access token: https://vercel.com/account/settings/tokens
# Team id: https://vercel.com/account/settings ("team_..."), or the team's settings.
# Project id: any project's Settings -> General ("prj_...").
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- Arete -----------------------------------------------------------------
# Optional. Agent keys (a4_ak_...) written into each sandbox's `agent`
# profile; comma separated, one per concurrent run keeps usage attributable.
# Leave empty to sign up one trial agent that every run shares (its key is
# cached in output/.cache/agent-key). Trial agents have usage allowances;
# use raised-limit keys for the full matrix.
ARETE_AGENT_KEYS=

# --- Results ---------------------------------------------------------------
# Where run directories are written. Point at a clone of the private results
# repository to keep transcripts out of this repo. Defaults to ./output.
BENCH_RESULTS_DIR=
