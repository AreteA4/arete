# --- Models: Vercel AI Gateway (default) ---------------------------------
# One key serves every harness: Claude Code, Codex and OpenCode.
# Create at https://vercel.com/<team>/~/ai -> API keys. The team needs a card
# on file before the gateway serves requests. VERCEL_OIDC_TOKEN also works.
AI_GATEWAY_API_KEY=

# --- Models: direct provider keys (only with --model-auth direct) --------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Vercel Sandbox --------------------------------------------------------
# Access token: https://vercel.com/account/settings/tokens
# Team id: https://vercel.com/account/settings ("team_..."), or the team's settings.
# Project id: any project's Settings -> General ("prj_...").
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- Arete -----------------------------------------------------------------
# Agent keys (a4_ak_...) written into each sandbox's `agent` profile.
# Comma separated: concurrent runs each get their own key while the pool
# lasts, which keeps per-run usage meters attributable. Leave empty to let
# every run sign up a fresh trial agent (limited to 5/hour/IP).
ARETE_AGENT_KEYS=

# --- Results ---------------------------------------------------------------
# Where run directories are written. Point at a clone of the private results
# repository to keep transcripts out of this repo. Defaults to ./output.
BENCH_RESULTS_DIR=
