{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@programs/*": [
        "./generated/typescript/programs/*/index.js"
      ]
    }
  },
  "include": [
    "*.ts",
    "scripts",
    "generated"
  ]
}
