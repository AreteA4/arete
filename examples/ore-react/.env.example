# Defaults to the production endpoints embedded in the generated ORE stack.
# Overrides must be supplied as a pair.
# VITE_ARETE_WS_URL=wss://ore.stack.arete.run
# VITE_ARETE_HTTP_URL=https://ore.stack.arete.run

# Alternatively, explicitly derive HTTP(S) from an overridden WS(S) URL.
# VITE_ARETE_WS_URL=wss://ore.stack.arete.run
# VITE_DERIVE_ARETE_HTTP=true

# ORE is deployed on mainnet. Explicit devnet, testnet, and local RPC URLs are rejected.
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_EXPLORER_URL=https://solscan.io/tx

# Optional. There is no bundled publishable-key fallback.
VITE_ARETE_PUBLISHABLE_KEY=
# Transaction relay is the default and does not require a Solana RPC URL.
VITE_TRANSACTION_TRANSPORT=auto
# For explicit direct mode, set VITE_TRANSACTION_TRANSPORT=direct and provide:
# VITE_SOLANA_RPC_URL=https://your-mainnet-rpc.example
