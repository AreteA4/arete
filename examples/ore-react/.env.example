# Defaults come from the generated ORE stack (ore.stack.arete.run).
# Override only to point at a different Arete stack.
# VITE_ARETE_WS_URL=wss://ore.stack.arete.run
# VITE_ARETE_HTTP_URL=https://ore.stack.arete.run

# Optional. Without a key the app connects anonymously with shared
# low-trust limits; a key attributes usage to your own quota.
# VITE_ARETE_PUBLISHABLE_KEY=
