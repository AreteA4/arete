      "input": {
        "secret": "whsec_test",
        "body": "{\"id\":\"evt_1\",\"event\":\"raise.succeeded\",\"deploymentId\":\"dep_1\",\"instanceId\":\"inst_1\",\"participantId\":null,\"state\":\"succeeded\",\"occurredAt\":\"2026-10-13T00:00:00Z\"}",
