{
  "version": 1,
  "description": "The switch: option, variables, session file and secret key in; the mode, or an error, out. `devInputsRead: false` means the implementation must not read ARETE_DEV_URL, ARETE_DEV_ENV or the session file to reach that answer.",
  "cases": [
    {
      "name": "nothing set is production",
      "input": {
        "browser": false,
        "option": null,
        "variables": {},
        "sessionFile": null,
        "secretKey": false
      },
      "expect": {
        "mode": "production",
        "devInputsRead": false
      }
    },
    {
      "name": "production explicitly",
      "input": {
        "browser": false,
        "option": null,
        "variables": {
          "ARETE_ENVIRONMENT": "production"
        },
        "sessionFile": null,
        "secretKey": false
      },
      "expect": {
        "mode": "production",
        "devInputsRead": false
      }
    },
    {
      "name": "an empty switch is unset",
      "input": {
        "browser": false,
        "option": null,
        "variables": {
          "ARETE_ENVIRONMENT": ""
        },
        "sessionFile": null,
        "secretKey": false
      },
      "expect": {
        "mode": "production",
        "devInputsRead": false
      }
    },
    {
      "name": "production ignores every dev input",
      "input": {
        "browser": false,
        "option": null,
        "variables": {
          "ARETE_ENVIRONMENT": "production",
          "ARETE_DEV_URL": "http://127.0.0.1:8911",
          "ARETE_DEV_ENV": "denv_01jabcdefghjkmnpqrstvwxyz0"
        },
        "sessionFile": {
          "edgeUrl": "http://127.0.0.1:8911"
        },
        "secretKey": true
      },
      "expect": {
        "mode": "production",
        "devInputsRead": false
      }
    },
    {
      "name": "dev inputs alone do not switch",
      "input": {
        "browser": false,
        "option": null,
        "variables": {
          "ARETE_DEV_URL": "http://127.0.0.1:8911",
          "ARETE_DEV_ENV": "denv_01jabcdefghjkmnpqrstvwxyz0"
        },
        "sessionFile": {
          "edgeUrl": "http://127.0.0.1:8911"
        },
        "secretKey": true
      },
      "expect": {
        "mode": "production",
        "devInputsRead": false
      }
    },
    {
      "name": "dev through the edge from ARETE_DEV_URL",
      "input": {
        "browser": false,
        "option": null,
        "variables": {
          "ARETE_ENVIRONMENT": "dev",
          "ARETE_DEV_URL": "http://127.0.0.1:8911"
        },
        "sessionFile": null,
        "secretKey": false
      },
      "expect": {
        "mode": "dev",
        "via": "edge",
        "edgeUrl": "http://127.0.0.1:8911"
      }
    },
    {
      "name": "an edge URL loses its trailing slash",
      "input": {
        "browser": false,
        "option": null,
        "variables": {
          "ARETE_ENVIRONMENT": "dev",
          "ARETE_DEV_URL": "http://127.0.0.1:8911/"
        },
        "sessionFile": null,
        "secretKey": false
      },
      "expect": {
        "mode": "dev",
        "via": "edge",
        "edgeUrl": "http://127.0.0.1:8911"
      }
    },
    {
      "name": "localhost is a loopback edge",
      "input": {
        "browser": false,
        "option": null,
        "variables": {
          "ARETE_ENVIRONMENT": "dev",
          "ARETE_DEV_URL": "http://localhost:8911"
        },
        "sessionFile": null,
        "secretKey": false
      },
      "expect": {
        "mode": "dev",
        "via": "edge",
        "edgeUrl": "http://localhost:8911"
      }
    },
    {
      "name": "IPv6 loopback is a loopback edge",
      "input": {
        "browser": false,
        "option": null,
        "variables": {
          "ARETE_ENVIRONMENT": "dev",
          "ARETE_DEV_URL": "http://[::1]:8911"
        },
        "sessionFile": null,
        "secretKey": false
      },
      "expect": {
        "mode": "dev",
        "via": "edge",
        "edgeUrl": "http://[::1]:8911"
      }
    },
    {
      "name": "https on loopback is an edge",
      "input": {
        "browser": false,
        "option": null,
        "variables": {
          "ARETE_ENVIRONMENT": "dev",
          "ARETE_DEV_URL": "https://127.0.0.1:8911"
        },
        "sessionFile": null,
        "secretKey": false
      },
      "expect": {
        "mode": "dev",
        "via": "edge",
        "edgeUrl": "https://127.0.0.1:8911"
      }
    },
