      }
    },
    {
      "name": "ARETE_DEV_URL beats the session file",
      "input": {
        "browser": false,
        "option": null,
        "variables": {
          "ARETE_ENVIRONMENT": "dev",
          "ARETE_DEV_URL": "http://127.0.0.1:9000"
        },
        "sessionFile": {
          "edgeUrl": "http://127.0.0.1:8911"
        },
        "secretKey": false
      },
      "expect": {
        "mode": "dev",
        "via": "edge",
        "edgeUrl": "http://127.0.0.1:9000"
      }
    },
    {
      "name": "dev with no target",
      "input": {
        "browser": false,
