{
  "version": 1,
  "description": "Every refusal: where it starts (`switch`, `edge`, `resolve` or a `service` answer) and the SDK error it becomes. `code` is the SDK error's code; `fix` and `details` are carried in its details. `productionRequests: 0` means the SDK makes no request to a production endpoint after the refusal (no fallback); `devRequests: 0` the same for dev endpoints.",
  "cases": [
    {
      "name": "devenv-not-configured: dev mode with no target",
      "input": {
        "source": "switch",
        "switch": {
          "browser": false,
          "option": null,
          "variables": {
            "ARETE_ENVIRONMENT": "dev"
          },
          "sessionFile": null,
          "secretKey": false
        }
      },
      "expect": {
        "code": "devenv-not-configured",
        "productionRequests": 0
      }
    },
    {
      "name": "devenv-not-configured: direct mode in a browser",
      "input": {
        "source": "switch",
        "switch": {
          "browser": true,
          "option": {
            "kind": "dev",
            "env": "denv_01jabcdefghjkmnpqrstvwxyz0"
          },
          "variables": {},
          "sessionFile": null,
          "secretKey": false
        }
      },
      "expect": {
        "code": "devenv-not-configured",
        "productionRequests": 0
      }
    },
    {
      "name": "INVALID_CONFIG: an unknown switch value",
      "input": {
        "source": "switch",
        "switch": {
          "browser": false,
          "option": null,
          "variables": {
            "ARETE_ENVIRONMENT": "staging"
          },
          "sessionFile": null,
          "secretKey": false
        }
      },
      "expect": {
        "code": "INVALID_CONFIG",
        "productionRequests": 0
      }
    },
    {
      "name": "devenv-edge-unreachable: nothing listens on the edge",
      "input": {
        "source": "edge",
        "mode": {
          "mode": "dev",
          "via": "edge",
          "edgeUrl": "http://127.0.0.1:8911"
        },
        "edgeAnswer": {
          "kind": "connection-refused"
        }
      },
      "expect": {
        "code": "devenv-edge-unreachable",
        "productionRequests": 0
      }
    },
    {
      "name": "devenv-edge-unreachable: something that is not an edge answers",
      "input": {
        "source": "edge",
        "mode": {
          "mode": "dev",
          "via": "edge",
          "edgeUrl": "http://127.0.0.1:8911"
        },
        "edgeAnswer": {
          "kind": "response",
          "status": 200,
          "headers": {},
          "body": {
            "result": 1
          }
        }
      },
      "expect": {
        "code": "devenv-edge-unreachable",
        "productionRequests": 0
      }
    },
    {
      "name": "devenv-edge-unreachable: a socket's edge check gets something that is not an edge",
      "input": {
        "source": "edge",
        "mode": {
          "mode": "dev",
          "via": "edge",
          "edgeUrl": "http://127.0.0.1:8911"
        },
        "surface": "stack",
        "edgeAnswer": {
          "kind": "response",
          "request": "GET /.well-known/arete-dev-edge",
          "status": 200,
          "headers": {
            "Content-Type": "text/html"
          },
          "body": "<!doctype html><title>Vite</title>"
        }
      },
      "expect": {
        "code": "devenv-edge-unreachable",
        "failingSurface": "stack",
        "socketsOpened": 0,
        "productionRequests": 0
      }
    },
