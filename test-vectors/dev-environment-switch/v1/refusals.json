      "expect": {
        "code": "devenv-stack-not-loaded",
        "message": "klend (arete:h1:stack-manifest:sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd) is not loaded in my-env",
        "fix": "Run `a4 dev up`: it loads every stack in arete.lock.",
        "failingSurface": "stack",
        "otherSurfacesUsable": true,
        "productionRequests": 0
      }
