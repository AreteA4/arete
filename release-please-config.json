{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "always-update": true,
  "packages": {
    "arete": {
      "release-type": "rust",
      "component": "arete",
      "extra-files": [
        {
          "type": "toml",
          "path": "/arete/Cargo.toml",
          "jsonpath": "$['dependencies']['arete-sdk']['version']"
        },
        {
          "type": "toml",
          "path": "/stacks/ore/Cargo.toml",
          "jsonpath": "$['dependencies']['arete']['version']"
        },
        {
          "type": "toml",
          "path": "/stacks/ore/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == \"arete\" || @.name.value == \"arete-a4-sdk\" || @.name.value == \"arete-interpreter\" || @.name.value == \"arete-macros\" || @.name.value == \"arete-server\")].version"
        },
        {
          "type": "toml",
          "path": "/examples/ore-server/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == \"arete\" || @.name.value == \"arete-a4-sdk\" || @.name.value == \"arete-interpreter\" || @.name.value == \"arete-macros\" || @.name.value == \"arete-server\")].version"
        }
      ]
    },
    "interpreter": {
      "release-type": "rust",
      "component": "arete-interpreter"
    },
    "arete-macros": {
      "release-type": "rust",
      "component": "arete-macros"
    },
    "cli": {
      "release-type": "rust",
      "component": "a4-cli",
      "extra-files": [
        {
          "type": "toml",
          "path": "/cli/Cargo.toml",
          "jsonpath": "$['dependencies']['arete-sdk']['version']"
        },
        {
          "type": "json",
          "path": "/examples/ore-react/src/generated/sdk-provenance.json",
          "jsonpath": "$.generator.version"
        },
        {
          "type": "json",
          "path": "/examples/ore-typescript/src/generated/sdk-provenance.json",
          "jsonpath": "$.generator.version"
        }
      ]
    },
    "rust/arete-auth": {
      "release-type": "rust",
      "component": "arete-auth"
    },
    "rust/arete-server": {
      "release-type": "rust",
      "component": "arete-server"
    },
    "rust/arete-mcp": {
      "release-type": "rust",
      "component": "arete-mcp",
      "extra-files": [
        {
          "type": "toml",
          "path": "/rust/arete-mcp/Cargo.toml",
          "jsonpath": "$['dependencies']['arete-sdk']['version']"
        }
      ]
    },
    "rust/arete-a4-sdk": {
      "release-type": "rust",
      "component": "arete-sdk"
    },
    "typescript/react": {
      "release-type": "node",
      "component": "arete-react",
      "extra-files": [
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$['packages']['']['dependencies']['@usearete/sdk']"
        }
      ]
    },
    "typescript/core": {
      "release-type": "node",
      "component": "arete-typescript"
    },
    "typescript/adapters/kit": {
      "release-type": "node",
      "component": "arete-adapter-kit",
      "extra-files": [
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$['packages']['']['devDependencies']['@usearete/sdk']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$['packages']['']['peerDependencies']['@usearete/sdk']"
        }
      ]
    },
    "typescript/adapters/web3js": {
      "release-type": "node",
      "component": "arete-adapter-web3js",
      "extra-files": [
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$['packages']['']['devDependencies']['@usearete/sdk']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$['packages']['']['peerDependencies']['@usearete/sdk']"
        }
      ]
    },
    "packages/arete": {
      "release-type": "node",
      "component": "a4-npm"
    },
    "packages/mcp": {
      "release-type": "node",
      "component": "arete-mcp-npm"
    },
    "arete-idl": {
      "release-type": "rust",
      "component": "arete-idl"
    }
  },
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "node-workspace",
      "merge": false,
      "updatePeerDependencies": true
    },
    {
      "type": "linked-versions",
      "groupName": "arete",
      "components": [
        "arete",
        "arete-interpreter",
        "arete-sdk",
        "arete-macros",
        "a4-cli",
        "arete-mcp",
        "arete-server",
        "arete-react",
        "arete-typescript",
        "arete-adapter-kit",
        "arete-adapter-web3js",
        "a4-npm",
        "arete-mcp-npm"
      ]
    }
  ]
}
