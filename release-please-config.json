{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "always-update": true,
  "packages": {
    "arete": {
      "release-type": "rust",
      "component": "arete",
      "extra-files": [
        {
          "type": "toml",
          "path": "/stacks/ore/Cargo.toml",
          "jsonpath": "$['dependencies']['arete']['version']"
        },
        {
          "type": "toml",
          "path": "/stacks/ore/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == \"arete\" || @.name.value == \"arete-a4-sdk\" || @.name.value == \"arete-interpreter\" || @.name.value == \"arete-macros\" || @.name.value == \"arete-server\")].version"
        },
        {
          "type": "toml",
          "path": "/examples/ore-server/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == \"arete\" || @.name.value == \"arete-a4-sdk\" || @.name.value == \"arete-interpreter\" || @.name.value == \"arete-macros\" || @.name.value == \"arete-server\")].version"
        }
      ]
    },
    "interpreter": {
      "release-type": "rust",
      "component": "arete-interpreter"
    },
    "arete-macros": {
      "release-type": "rust",
      "component": "arete-macros"
    },
    "cli": {
      "release-type": "rust",
      "component": "a4-cli",
      "extra-files": [
        {
          "type": "json",
          "path": "/docs/public/a4/latest.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "rust/arete-auth": {
      "release-type": "rust",
      "component": "arete-auth"
    },
    "rust/arete-server": {
      "release-type": "rust",
      "component": "arete-server"
    },
    "rust/arete-mcp": {
      "release-type": "rust",
      "component": "arete-mcp"
    },
    "rust/arete-a4-sdk": {
      "release-type": "rust",
      "component": "arete-sdk",
      "extra-files": [
        {
          "type": "generic",
          "path": "README.md"
        }
      ]
    },
    "typescript/react": {
      "release-type": "node",
      "component": "arete-react"
    },
    "typescript/core": {
      "release-type": "node",
      "component": "arete-typescript"
    },
    "typescript/hash": {
      "release-type": "node",
      "component": "arete-hash-npm",
      "initial-version": "0.1.0"
    },
    "typescript/adapters/kit": {
      "release-type": "node",
      "component": "arete-adapter-kit"
    },
    "typescript/adapters/web3js": {
      "release-type": "node",
      "component": "arete-adapter-web3js"
    },
    "packages/arete": {
      "release-type": "node",
      "component": "a4-npm"
    },
    "packages/mcp": {
      "release-type": "node",
      "component": "arete-mcp-npm"
    },
    "python/arete-sdk": {
      "release-type": "python",
      "component": "arete-python"
    },
    "arete-idl": {
      "release-type": "rust",
      "component": "arete-idl"
    },
    "arete-hash": {
      "release-type": "rust",
      "component": "arete-hash",
      "initial-version": "0.1.0"
    },
    "arete-artifacts": {
      "release-type": "rust",
      "component": "arete-artifacts",
      "initial-version": "0.1.0"
    }
  },
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "node-workspace",
      "merge": false,
      "updatePeerDependencies": true
    },
    {
      "type": "linked-versions",
      "groupName": "arete",
      "components": [
        "arete",
        "arete-interpreter",
        "arete-sdk",
        "arete-macros",
        "a4-cli",
        "arete-mcp",
        "arete-server",
        "arete-react",
        "arete-typescript",
        "arete-adapter-kit",
        "arete-adapter-web3js",
        "a4-npm",
        "arete-mcp-npm",
        "arete-python"
      ]
    }
  ]
}
