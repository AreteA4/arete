{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "packages": {
    "arete": {
      "release-type": "rust",
      "component": "arete"
    },
    "interpreter": {
      "release-type": "rust",
      "component": "arete-interpreter"
    },
    "arete-macros": {
      "release-type": "rust",
      "component": "arete-macros"
    },
    "cli": {
      "release-type": "rust",
      "component": "a4-cli"
    },
    "rust/arete-a4-sdk": {
      "release-type": "rust",
      "component": "arete-sdk",
      "extra-files": [
        {
          "type": "toml",
          "path": "/arete/Cargo.toml",
          "jsonpath": "$['dependencies']['arete-sdk']['version']"
        },
        {
          "type": "toml",
          "path": "/cli/Cargo.toml",
          "jsonpath": "$['dependencies']['arete-sdk']['version']"
        },
        {
          "type": "toml",
          "path": "/rust/arete-mcp/Cargo.toml",
          "jsonpath": "$['dependencies']['arete-sdk']['version']"
        }
      ]
    },
    "rust/arete-auth": {
      "release-type": "rust",
      "component": "arete-auth"
    },
    "rust/arete-server": {
      "release-type": "rust",
      "component": "arete-server"
    },
    "rust/arete-mcp": {
      "release-type": "rust",
      "component": "arete-mcp"
    },
    "typescript/react": {
      "release-type": "node",
      "component": "arete-react"
    },
    "typescript/core": {
      "release-type": "node",
      "component": "arete-typescript"
    },
    "packages/arete": {
      "release-type": "node",
      "component": "a4-npm"
    },
    "packages/mcp": {
      "release-type": "node",
      "component": "arete-mcp-npm"
    },
    "arete-idl": {
      "release-type": "rust",
      "component": "arete-idl"
    }
  },
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "node-workspace",
      "merge": false,
      "updatePeerDependencies": true
    },
    {
      "type": "linked-versions",
      "groupName": "arete",
      "components": [
        "arete",
        "arete-interpreter",
        "arete-sdk",
        "arete-macros",
        "a4-cli",
        "arete-mcp",
        "arete-server",
        "arete-react",
        "arete-typescript",
        "a4-npm",
        "arete-mcp-npm"
      ]
    }
  ]
}
