# Arete project dependency manifest
manifest_version = 1

[project]
name = "my-project"
private = true

[install]
allow_outside_project = false

[sdk]
targets = ["typescript", "rust"]

[sdk.typescript]
output_dir = "./src/generated"
package = "@myorg/my-sdk"

[sdk.rust]
output_dir = "./crates/generated"
module_mode = false
crate_prefix = "my_project"

[dependencies.stacks.ore]
source = { registry = "ore" }
version = "^1.0.0"

[authoring.stacks.local]
manifest = "./.arete/MyStack.stack-manifest.json"
artifact_roots = ["./.arete"]

# Install the authored stack explicitly when its SDK is needed.
[dependencies.stacks.local]
source = { workspace = "local" }

# Settings for `a4 protocol deploy` (optional; flags override them).
# Paths are relative to this file's directory.
[protocol]
slug = "token-raise"
name = "Token Raise"
fee_policy = "./fee-policy.json"
access = "private" # self-serve deployments are private

# A string is a path to a JSON file; any other TOML value is the value itself.
[protocol.resources]
launchDefaults = "./resources/launch-defaults.json"
# launchDefaults = { tokenDecimals = 6 }
