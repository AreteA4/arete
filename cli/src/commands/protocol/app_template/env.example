# The app's publishable key (origin-bound; `public` steps only) goes in
# .env.local: a4 auth keys create-publishable --origin http://localhost:5173 --env-file .env.local

# The automations server (server/index.ts).
ARETE_SECRET_KEY=
APP_API_TOKEN=change-me
# In dev: the contents of .arete/dev/automations/webhook-secret.
ARETE_WEBHOOK_SECRET=
# Production only: Postgres for jobs and consent, and Privy for signing.
DATABASE_URL=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
