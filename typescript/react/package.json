{
  "name": "@usearete/react",
  "version": "0.8.0",
  "type": "module",
  "description": "React SDK for the Arete Solana developer platform",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AreteA4/arete.git",
    "directory": "typescript/react"
  },
  "homepage": "https://github.com/AreteA4/arete#readme",
  "bugs": {
    "url": "https://github.com/AreteA4/arete/issues"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest && node eslint-rules/arete-hooks.test.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --rulesdir eslint-rules",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "typescript",
    "react",
    "solana",
    "streaming",
    "websockets"
  ],
  "author": "Arete Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@usearete/sdk": "^0.8.0",
    "zustand": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.0.0",
    "react-test-renderer": "^19.2.5",
    "rollup": "^3.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "ts-jest": "^29.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "eslint-plugin.cjs",
    "eslint-rules",
    "!eslint-rules/*.test.cjs",
    "README.md"
  ]
}
