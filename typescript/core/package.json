{
  "name": "@usearete/sdk",
  "version": "0.44.2",
  "type": "module",
  "description": "Pure TypeScript SDK for the Arete Solana streaming platform",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "arete": {
    "extensionApi": 1
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.ts"
      ],
      "program": [
        "./dist/program.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./program": {
      "types": "./dist/program.d.ts",
      "import": "./dist/program.esm.js",
      "require": "./dist/program.cjs"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.esm.js",
      "require": "./dist/ssr/index.cjs"
    },
    "./ssr/handlers": {
      "types": "./dist/ssr/handlers.d.ts",
      "import": "./dist/ssr/handlers.esm.js",
      "require": "./dist/ssr/handlers.cjs"
    },
    "./ssr/nextjs-app": {
      "types": "./dist/ssr/nextjs-app.d.ts",
      "import": "./dist/ssr/nextjs-app.esm.js",
      "require": "./dist/ssr/nextjs-app.cjs"
    },
    "./ssr/vite": {
      "types": "./dist/ssr/vite.d.ts",
      "import": "./dist/ssr/vite.esm.js",
      "require": "./dist/ssr/vite.cjs"
    },
    "./ssr/tanstack-start": {
      "types": "./dist/ssr/tanstack-start.d.ts",
      "import": "./dist/ssr/tanstack-start.esm.js",
      "require": "./dist/ssr/tanstack-start.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.esm.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AreteA4/arete.git",
    "directory": "typescript/core"
  },
  "homepage": "https://github.com/AreteA4/arete#readme",
  "bugs": {
    "url": "https://github.com/AreteA4/arete/issues"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "typescript",
    "solana",
    "streaming",
    "websockets",
    "arete"
  ],
  "author": "Arete Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "buffer": "^6.0.3",
    "jsonwebtoken": "^9.0.2",
    "pako": "^2.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/pako": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.0.0",
    "rollup": "^3.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
