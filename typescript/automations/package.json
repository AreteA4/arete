{
  "name": "@usearete/automations",
  "version": "0.49.0",
  "type": "module",
  "description": "Server-side automation of Arete Protocol steps on a user's behalf, with pluggable signers and a signing policy",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./keypair": {
      "types": "./dist/keypair.d.ts",
      "import": "./dist/keypair.js",
      "require": "./dist/keypair.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "require": "./dist/postgres.cjs"
    },
    "./privy": {
      "types": "./dist/privy.d.ts",
      "import": "./dist/privy.js",
      "require": "./dist/privy.cjs"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js",
      "require": "./dist/cloudflare.cjs"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js",
      "require": "./dist/vercel.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js",
      "require": "./dist/dev.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "keypair": [
        "./dist/keypair.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ],
      "postgres": [
        "./dist/postgres.d.ts"
      ],
      "privy": [
        "./dist/privy.d.ts"
      ],
      "cloudflare": [
        "./dist/cloudflare.d.ts"
      ],
      "vercel": [
        "./dist/vercel.d.ts"
      ],
      "node": [
        "./dist/node.d.ts"
      ],
      "dev": [
        "./dist/dev.d.ts"
      ]
    }
  },
  "bin": {
    "arete-automations": "./dist/cli.js"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AreteA4/arete.git",
    "directory": "typescript/automations"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src examples --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "arete",
    "protocol",
    "automation",
    "solana"
  ],
  "author": "Arete Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6"
  },
  "peerDependencies": {
    "@usearete/sdk": "^0.49.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/node": "22.20.1",
    "@types/pg": "8.15.5",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@usearete/sdk": "^0.49.0",
    "eslint": "8.57.1",
    "pg": "8.16.3",
    "rollup": "3.29.5",
    "rollup-plugin-dts": "6.2.3",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "1.6.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
