{
  "name": "@usearete/adapter-web3js",
  "version": "0.1.0",
  "type": "module",
  "description": "@solana/web3.js wallet adapter for the Arete SDK instruction boundary",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AreteA4/arete.git",
    "directory": "typescript/adapters/web3js"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:pack": "npm run build && node ./scripts/pack-smoke.mjs"
  },
  "keywords": [
    "solana",
    "web3.js",
    "wallet",
    "arete"
  ],
  "author": "Arete Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.95.0",
    "@usearete/sdk": "^0.2.0 || ^0.3.0"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "rpc-websockets": "9.3.8"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.0.0",
    "@solana/web3.js": "^1.95.0",
    "@types/node": "^20.0.0",
    "@usearete/sdk": "^0.2.0 || ^0.3.0",
    "rollup": "^3.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0",
    "vite": "^6.4.3",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
