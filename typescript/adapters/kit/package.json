{
  "name": "@usearete/adapter-kit",
  "version": "0.8.0",
  "type": "module",
  "description": "@solana/kit wallet adapter for the Arete SDK instruction boundary",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AreteA4/arete.git",
    "directory": "typescript/adapters/kit"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:pack": "npm run build && node pack-smoke.mjs"
  },
  "keywords": [
    "solana",
    "kit",
    "wallet",
    "arete"
  ],
  "author": "Arete Team",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "peerDependencies": {
    "@solana/kit": "^2.3.0",
    "@usearete/sdk": "^0.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.0.0",
    "@solana/kit": "2.3.0",
    "@types/node": "^20.0.0",
    "@usearete/sdk": "^0.8.0",
    "rollup": "^3.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
