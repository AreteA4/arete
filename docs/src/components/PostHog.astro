---
/**
 * PostHog Analytics Component
 *
 * Loads PostHog for:
 * - Page view tracking
 * - Autocapture (clicks, form submits)
 * - Session replay
 * - Custom event tracking
 *
 * Uses a reverse proxy through Vercel to bypass ad-blockers.
 *
 * NOTE: The init snippet was previously inlined here. It is now in
 * /public/posthog-init.js, loaded with `defer`. This was done to satisfy
 * the AFDocs "Content Start Position" check — the inline ~3KB snippet
 * pushed page content past 50% in the converted markdown output. Behavior
 * is unchanged; init now runs after HTML parse but before DOMContentLoaded.
 *
 * Environment Variables:
 * - PUBLIC_POSTHOG_KEY: Your PostHog project API key (required)
 *
 * @see https://posthog.com/docs/libraries/astro
 */

// Get PostHog key from environment variable.
// In Astro, PUBLIC_ prefixed env vars are available on the client.
// Passed to the external init script via the data-posthog-key attribute.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY || "";
---

<script
  is:inline
  defer
  src="/posthog-init.js"
  data-posthog-init
  data-posthog-key={posthogKey}></script>
