---
/**
 * Deferred client scripts (analytics + docs UX tracking).
 * Loaded after page content to keep primary HTML payload closer to article body.
 */
import PostHog from "./PostHog.astro";
---

<PostHog />

<script>
  // Bundled by Astro. Click handlers are delegated on `document`, so they
  // survive Starlight view transitions. `trackDocsEvent` reads the pathname
  // at click time and queues until the PostHog stub from posthog-init.js exists.
  import {
    classifyCopiedSnippet,
    codePreview,
    outboundDestination,
    sdkLanguageFromPath,
    sdkLanguageFromTabLabel,
    trackDocsEvent,
  } from "../../lib/docs-analytics.mjs";

  function linkLabel(link: Element) {
    return (link.textContent || "").replace(/\s+/g, " ").trim().slice(0, 80);
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    const tab = target.closest('starlight-tabs [role="tab"]');
    if (tab) {
      const tabLabel =
        tab.getAttribute("aria-label") || tab.textContent?.trim() || "unknown";
      const syncKey = tab
        .closest("starlight-tabs")
        ?.getAttribute("data-sync-key");
      trackDocsEvent("docs_tab_clicked", {
        tab_name: tabLabel,
        ...(syncKey ? { sync_key: syncKey } : {}),
      });
      const language = sdkLanguageFromTabLabel(tabLabel);
      if (language) {
        trackDocsEvent("docs_sdk_lang_tab", {
          language,
          tab_name: tabLabel,
          surface: "tab",
          ...(syncKey ? { sync_key: syncKey } : {}),
        });
      }
    }

    const copyButton = target.closest<HTMLElement>(
      ".expressive-code .copy button",
    );
    if (copyButton) {
      const block = copyButton.closest("figure, .expressive-code");
      const pre = block?.querySelector("pre");
      const language =
        pre?.getAttribute("data-language") ||
        pre?.querySelector("code")?.className.match(/language-(\w+)/)?.[1] ||
        "unknown";
      const copied =
        copyButton.getAttribute("data-code") ||
        block?.querySelector("code")?.textContent ||
        "";
      trackDocsEvent("docs_code_copied", {
        language,
        code_preview: codePreview(copied),
      });
      const cli = classifyCopiedSnippet(copied);
      if (cli) {
        trackDocsEvent("docs_cli_copy", {
          language,
          snippet_kind: cli.snippet_kind,
          code_preview: cli.code_preview,
        });
      }
    }

    const installCta = target.closest<HTMLAnchorElement>(
      "a[data-docs-cta='install']",
    );
    if (installCta) {
      trackDocsEvent("docs_install_cta_click", {
        cta: installCta.dataset.docsCta || "install",
        href: installCta.getAttribute("href") || "",
        label: linkLabel(installCta),
      });
    }

    const link = target.closest<HTMLAnchorElement>("a[href]");
    if (!link?.href) return;

    let destinationPath = "";
    try {
      destinationPath = new URL(link.href).pathname;
    } catch {
      return;
    }

    const destination = outboundDestination(link.href);
    if (destination === "github" || destination === "x") {
      trackDocsEvent("docs_outbound", {
        destination,
        href: link.href,
        path: destinationPath,
        label: linkLabel(link),
      });
    }

    const toLanguage = sdkLanguageFromPath(destinationPath);
    const fromLanguage = sdkLanguageFromPath(window.location.pathname);
    if (toLanguage && toLanguage !== fromLanguage) {
      trackDocsEvent("docs_sdk_lang_tab", {
        language: toLanguage,
        ...(fromLanguage ? { from_language: fromLanguage } : {}),
        surface: "nav",
        href: link.getAttribute("href") || "",
        label: linkLabel(link),
      });
    }
  });
</script>
