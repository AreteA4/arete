---
import Default from "@astrojs/starlight/components/MarkdownContent.astro";

const site = Astro.site?.href?.replace(/\/$/, "") ?? "https://docs.arete.run";
const llmsUrl = `${site}/llms.txt`;
const llmsFullUrl = `${site}/llms-full.txt`;
---

<Default>
  <p class="agent-docs-discovery sr-only">
    For AI agents: the documentation index is at{" "}
    <a href={llmsUrl}>llms.txt</a> (full corpus:{" "}
    <a href={llmsFullUrl}>llms-full.txt</a>). A markdown source for this page is
    published at the same URL path with <code>.md</code> appended.
  </p>
  <slot />
</Default>
