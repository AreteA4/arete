---
/**
 * Custom PageTitle with Copy Markdown button
 *
 * Adds a "Copy Markdown" button next to the page title that copies
 * the raw markdown content directly from the content entry.
 * Works in both dev and production modes.
 */
import Default from "@astrojs/starlight/components/PageTitle.astro";
// Import the manifest directly - Vite handles this at build time
import manifest from "../../../../.release-please-manifest.json";

const { entry } = Astro.locals.starlightRoute;
const { title } = entry.data;
const isHome = Astro.url.pathname === "/";

// TODO: Rename when packages are changed over
// Get version from the imported manifest (resolved at build time by Vite)
const version = (manifest as Record<string, string>)["arete"] || "0.0.0";

// Build clean markdown content with title, replacing {{VERSION}} placeholders
const rawBody = entry.body || "";
const processedBody = rawBody.replaceAll("{{VERSION}}", version);
const markdownContent = `# ${title}\n\n${processedBody}`;
---

<div class="page-title-wrapper">
  <div class="page-title-copy">
    <p class="page-eyebrow">
      <span aria-hidden="true"></span>Arete documentation
    </p>
    {
      !isHome && (
        <Default {...Astro.props}>
          <slot />
        </Default>
      )
    }
  </div>
  <div class="page-actions">
    <button
      class="copy-markdown-btn"
      id="copy-markdown"
      data-content={markdownContent}
      title="Copy page as Markdown"
    >
      <svg
        class="icon-copy"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
        ></path>
        <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
      </svg>
      <svg
        class="icon-check"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span class="btn-text">Copy Markdown</span>
    </button>
  </div>
</div>

<div class="agent-directive sr-only">
  <blockquote>
    For the complete documentation index optimized for AI agents, see <a
      href="/llms.txt">llms.txt</a
    > or <a href="/llms-full.txt">llms-full.txt</a>. A markdown version of this
    page is available by appending <code>.md</code> to the URL or sending <code
      >Accept: text/markdown</code
    >.
  </blockquote>
</div>

<style>
  .agent-directive.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-title-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 1.4rem;
    border-bottom: 1px solid var(--arete-line);
    padding-bottom: 1.35rem;
  }

  .page-title-copy {
    min-width: 0;
  }

  .page-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.8rem;
    color: var(--arete-muted);
    font-family: var(--arete-font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
  }

  .page-eyebrow span {
    display: block;
    width: 0.42rem;
    height: 0.42rem;
    background: var(--arete-accent);
  }

  .page-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .copy-markdown-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.35rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--arete-line-strong);
    border-radius: 0;
    background: var(--arete-panel);
    color: var(--arete-muted);
    cursor: pointer;
    font-family: var(--arete-font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  .copy-markdown-btn:hover {
    border-color: var(--arete-accent);
    color: var(--arete-foreground);
  }

  .copy-markdown-btn.copied {
    border-color: var(--arete-accent);
    color: var(--arete-accent);
  }

  .copy-markdown-btn .icon-check {
    display: none;
  }

  .copy-markdown-btn.copied .icon-copy {
    display: none;
  }

  .copy-markdown-btn.copied .icon-check {
    display: block;
  }

  @media (max-width: 640px) {
    .copy-markdown-btn .btn-text {
      display: none;
    }

    .copy-markdown-btn {
      width: 2.35rem;
      padding: 0;
      justify-content: center;
    }
  }
</style>

<script>
  function setupCopyButton() {
    const btn = document.getElementById("copy-markdown") as HTMLButtonElement;
    if (!btn || btn.dataset.copyReady === "true") return;
    btn.dataset.copyReady = "true";

    btn.addEventListener("click", async () => {
      const content = btn.dataset.content;
      if (!content) return;

      try {
        await navigator.clipboard.writeText(content);
        btn.classList.add("copied");
        const textEl = btn.querySelector(".btn-text");
        if (textEl) textEl.textContent = "Copied!";

        // Track copy event with PostHog
        if (typeof window !== "undefined" && (window as any).posthog) {
          (window as any).posthog.capture("docs_copy_markdown", {
            page: window.location.pathname,
            title: document.title,
          });
        }

        setTimeout(() => {
          btn.classList.remove("copied");
          if (textEl) textEl.textContent = "Copy Markdown";
        }, 2000);
      } catch (err) {
        console.error("Failed to copy:", err);
      }
    });
  }

  // Run on initial load
  setupCopyButton();

  // Re-run on Astro page transitions
  document.addEventListener("astro:page-load", setupCopyButton);
</script>
