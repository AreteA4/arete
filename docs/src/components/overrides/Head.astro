---
/**
 * Starlight head: meta and asset links only.
 * Client analytics lives in Footer.astro (see DocsClientScripts.astro).
 *
 * Discovery Link relations mirror Mintlify so agents can find llms.txt,
 * MCP, and well-known skill indexes from any HTML page.
 *
 * @see https://starlight.astro.build/guides/overriding-components/
 */
const { head } = Astro.locals.starlightRoute;
const site = Astro.site?.href?.replace(/\/$/, "") ?? "https://docs.arete.run";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Arete",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Solana",
      url: "https://arete.run",
      description:
        "Build and run Solana protocols, develop in persistent cloud mainnet forks, and integrate applications and agents through generated clients.",
      documentation: site,
    },
    {
      "@type": "WebSite",
      name: "Arete documentation",
      url: site,
      description:
        "Documentation, OpenAPI, and MCP for Arete protocols, cloud development, programs, and live data.",
    },
    {
      "@type": "Organization",
      name: "Arete",
      url: "https://arete.run",
      sameAs: ["https://github.com/AreteA4/arete", site],
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "developer support",
        url: `${site}/contact`,
      },
    },
  ],
};
---

<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f3efe4" />
<meta name="is-agentic-site-type" content="documentation" />
<meta property="og:image" content={`${site}/og.png`} />
<meta name="twitter:image" content={`${site}/og.png`} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<link
  rel="alternate"
  type="text/plain"
  title="llms.txt"
  href={`${site}/llms.txt`}
/>
<link rel="llms-txt" href={`${site}/llms.txt`} />
<link rel="llms-full-txt" href={`${site}/llms-full.txt`} />
<link rel="mcp-server-card" href={`${site}/.well-known/mcp/server-card.json`} />
<link rel="agent-skills" href={`${site}/.well-known/agent-skills`} />
<link rel="describedby" href={`${site}/openapi.json`} />

{
  head.map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))
}
