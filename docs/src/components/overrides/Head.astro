---
/**
 * Starlight head: meta and asset links only.
 * Client analytics lives in Footer.astro (see DocsClientScripts.astro).
 *
 * Discovery Link relations mirror Mintlify so agents can find llms.txt,
 * MCP, and well-known skill indexes from any HTML page.
 *
 * @see https://starlight.astro.build/guides/overriding-components/
 */
const { head } = Astro.locals.starlightRoute;
const site = Astro.site?.href?.replace(/\/$/, "") ?? "https://docs.arete.run";
---

<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f3efe4" />
<link
  rel="alternate"
  type="text/plain"
  title="llms.txt"
  href={`${site}/llms.txt`}
/>
<link rel="llms-txt" href={`${site}/llms.txt`} />
<link rel="llms-full-txt" href={`${site}/llms-full.txt`} />
<link rel="mcp-server-card" href={`${site}/.well-known/mcp/server-card.json`} />
<link rel="agent-card" href={`${site}/.well-known/agent-card.json`} />
<link rel="agent-skills" href={`${site}/.well-known/agent-skills`} />

{
  head.map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))
}
