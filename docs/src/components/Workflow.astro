---
interface Props {
  steps: Array<{
    title: string;
    description: string;
  }>;
}

const { steps } = Astro.props;
---

<div class="workflow-wrapper">
  <div class="workflow-container">
    {
      steps.map((step, index) => (
        <>
          <div class="workflow-step">
            <div class="step-header">
              <div class="step-number">
                {String(index + 1).padStart(2, "0")}
              </div>
              <h3 class="step-title">{step.title}</h3>
            </div>
            <p class="step-description">{step.description}</p>
          </div>
          {index < steps.length - 1 && <div class="workflow-arrow">→</div>}
        </>
      ))
    }
  </div>
</div>

<style is:global>
  .sl-markdown-content .workflow-wrapper * {
    margin-top: 0 !important;
  }
</style>

<style>
  .workflow-wrapper {
    margin: 1.25rem 0;
    border: 1px solid var(--arete-line-strong);
    background: var(--arete-panel);
    padding: 0.55rem;
  }

  .workflow-container {
    display: flex;
    align-items: stretch;
    gap: 0;
  }

  .workflow-step {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.45rem 1.25rem;
    background: var(--arete-panel-muted);
  }

  .step-header {
    display: block;
    margin-bottom: 0.85rem;
  }

  .step-number {
    margin-bottom: 1.25rem;
    color: var(--arete-accent);
    font-family: var(--arete-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.13em;
  }

  .step-title {
    color: var(--arete-foreground);
    font-family: var(--arete-font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .step-description {
    color: var(--arete-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .workflow-arrow {
    z-index: 1;
    display: flex;
    width: 1px;
    align-items: center;
    justify-content: center;
    border-inline-start: 1px dashed var(--arete-line-strong);
    color: var(--arete-accent);
    font-family: var(--arete-font-mono);
    font-size: 1rem;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .workflow-container {
      flex-direction: column;
      align-items: stretch;
    }

    .workflow-step {
      width: 100%;
    }

    .workflow-arrow {
      width: auto;
      height: 1px;
      border-top: 1px dashed var(--arete-line-strong);
      border-inline-start: 0;
      transform: none;
    }
  }
</style>
