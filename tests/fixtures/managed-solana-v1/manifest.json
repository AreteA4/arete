  "routes": [
    {
      "id": "rawAccount",
      "method": "POST",
      "path": "/chain/v1/account",
      "requestSchema": "accountRequest",
      "responseSchema": "rawSingleResponse",
      "defaults": {
        "options": {
          "commitment": "confirmed"
        },
        "minContextSlot": "omitted"
      },
      "errorSet": "chain",
      "scope": "read",
      "availability": "shared-server",
      "errorEnvelope": "chainAndDiscovery",
      "authorizationErrorSet": "authorization"
    },
    {
      "id": "rawAccounts",
      "method": "POST",
      "path": "/chain/v1/accounts",
      "requestSchema": "accountsRequest",
      "responseSchema": "rawBatchResponse",
      "defaults": {
        "options": {
          "commitment": "confirmed"
        },
        "maxAddresses": 100,
        "emptyResponse": {
          "context": null,
          "value": []
        }
      },
      "errorSet": "chain",
      "scope": "read",
      "availability": "shared-server",
      "errorEnvelope": "chainAndDiscovery",
      "authorizationErrorSet": "authorization"
    },
    {
      "id": "ownerTokenAccounts",
      "method": "POST",
      "path": "/chain/v1/owner-token-accounts",
      "requestSchema": "ownerRequest",
      "responseSchema": "ownerPage",
      "defaults": {
        "limit": 100,
        "cursor": "omitted",
        "mint": "omitted",
        "tokenProgram": "omitted"
      },
      "errorSet": "discovery",
      "scope": "read",
      "availability": "requires-OwnerTokenAccountsProvider",
      "errorEnvelope": "chainAndDiscovery",
      "authorizationErrorSet": "authorization"
    },
    {
      "id": "typedAccount",
      "method": "POST",
      "path": "/v1/releases/{programReleaseHash}/accounts/{accountType}/{address}/context",
      "requestSchema": "typedSingleRequest",
      "responseSchema": "typedSingleResponse",
      "defaults": {
        "options": {
          "commitment": "confirmed"
        },
        "missingResponse": {
          "context": {
            "slot": "actual-read-slot"
          },
          "value": null
        }
      },
      "errorSet": "programRead",
      "scope": "read",
      "availability": "requires-release-decoder",
      "errorEnvelope": "programRead",
      "authorizationErrorSet": "authorization"
    },
    {
      "id": "typedAccounts",
      "method": "POST",
      "path": "/v1/releases/{programReleaseHash}/accounts/{accountType}/context",
      "requestSchema": "accountsRequest",
      "responseSchema": "typedBatchResponse",
      "defaults": {
        "options": {
          "commitment": "confirmed"
        },
        "maxAddresses": 100,
        "emptyResponse": {
          "context": null,
          "value": {
            "items": []
          }
        }
      },
      "errorSet": "programRead",
      "scope": "read",
      "availability": "requires-release-decoder",
      "errorEnvelope": "programRead",
      "authorizationErrorSet": "authorization"
    },
    {
      "id": "nativePositionQuery",
      "method": "POST",
      "path": "/v1/releases/{programReleaseHash}/accounts/{accountType}/query",
      "requestSchema": "nativeQuery",
      "responseSchema": "nativePage",
      "defaults": {
        "limit": 100,
        "cursor": "omitted"
      },
      "errorSet": "nativeQuery",
      "scope": "read",
      "availability": "Hosted implementation; shared server returns 501 unsupported_capability",
      "errorEnvelope": "programReadOrCapability",
      "authorizationErrorSet": "authorization"
    },
    {
      "id": "fullTransaction",
      "method": "POST",
      "path": "/transactions/v1/get",
      "requestSchema": "transactionRequest",
      "responseSchema": "transactionResponse",
      "defaults": {
        "commitment": "finalized",
        "maxSupportedTransactionVersion": 1,
        "upstreamEncoding": "jsonParsed"
      },
      "errorSet": "transaction",
      "scope": "transaction:inspect",
      "availability": "requires-enabled-transaction-relay",
      "errorEnvelope": "transaction",
      "authorizationErrorSet": "authorization"
    }
  ],
