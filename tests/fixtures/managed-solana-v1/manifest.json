  "semantics": {
    "integerEncoding": "u64/u128/i128 quantities are decimal strings; indexes/counts/transaction versions are numbers",
    "readContext": "actual RPC read slot, decimal u64; null only if no read occurred (empty batch)",
    "discovery": "index provenance only; absent watermark is unknown; no implied chain commitment",
    "batchAlignment": "one result per requested address in input order, including duplicates and missing/error items",
    "typedItemErrors": "item-level error.code uses the programRead error set; HTTP batch remains 200",
    "typedAuthorization": "read scope plus exact binding target, program ID and release hash",
    "gatewayAuthorization": "read or transaction:inspect scope plus exact Solana gateway audience and binding target",
    "sessionLimits": "max_http_batch_addresses may lower the protocol ceiling; omitted discovery limit remains 100 and can exceed that session limit",
    "ordering": "discovery ordering/cursor is provider-defined; opaque cursor must bind owner, mint and tokenProgram",
    "unknownMetadata": "outer transaction=null means unseen; metadataAvailable=false with meta=null means observed execution metadata unavailable; no fabricated success, fee or balances",
    "nativeQuery": "At least owner or pool is required by the request contract and SDK validation. The shared server checks release/auth then returns 501 unsupported_capability before reading the body; Hosted implementations own request validation and the supported filter/type matrix.",
    "deletion": "account-deletion.json is a chain-to-runtime integration contract, not an HTTP endpoint; delete ends lifetime, remove is view eviction",
    "invalidJson": "chain/discovery malformed JSON or unknown request fields return 400 invalid_request; typed reads return 400 INVALID_REQUEST",
    "wrongMethod": "chain/typed routes return 404; transaction relay returns 405; no alias routes or /v2 workaround",
    "transactionErrors": "Handler and admission errors use the transaction envelope; gateway target and auth-plugin denials occur earlier and use the authorization envelope.",
    "authorizationErrors": "Configured auth plugins may return additional plugin-owned denial codes in the authorization envelope before any route handler runs."
  },
